# ==== Server ====
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string

# ==== Login credentials ====
# Simplest option: set the plain password directly here.
AUTH_USERNAME=Chandamama
AUTH_PASSWORD=chandamama@2002

# Optional alternative: use a bcrypt hash instead of a plain password.
# Run `npm run hash-password -- yourPassword` and paste the result below
# (leave AUTH_PASSWORD empty if you use this).
AUTH_PASSWORD_HASH=

# ==== Free API keys (sign up for each, all have free tiers) ====
# 1. QuickEmailVerification -> https://quickemailverification.com (100 free/day)
QEV_API_KEY=

# 2. Abstract API -> https://www.abstractapi.com/api/email-verification-validation-api (free tier/month)
ABSTRACT_API_KEY=

# 3. ZeroBounce -> https://www.zerobounce.net (100 free/month)
ZEROBOUNCE_API_KEY=

# ==== Daily quota assumptions (used to decide when to roll over to the next provider) ====
QEV_DAILY_LIMIT=3
ABSTRACT_DAILY_LIMIT=3
ZEROBOUNCE_DAILY_LIMIT=3
HUNTER_DAILY_LIMIT=3

# ==== Own SMTP verifier settings ====
VERIFIER_FROM_EMAIL=matlimahenderreddy01@gmail.com
SMTP_TIMEOUT_MS=8000

# The domain/email SMTP uses to identify itself and as the MAIL FROM sender.
# Use a REAL domain you control with valid MX + SPF records, or many servers
# will reject/greylist you immediately.
SMTP_HELO_DOMAIN=tektreeinc.com
SMTP_FROM_ADDRESS=mahender@tektreeinc.com

# Timeout for each SMTP step (ms)

# Max simultaneous SMTP connections across all requests
MAX_CONCURRENT_SMTP=5

# Delay between SMTP attempts to the SAME domain (ms) - avoids rate-limit/greylisting
SAME_DOMAIN_DELAY_MS=1500

# Retry attempts on greylist (4xx) responses
GREYLIST_RETRIES=1
GREYLIST_RETRY_DELAY_MS=5000


